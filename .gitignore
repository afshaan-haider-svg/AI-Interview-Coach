# =====================================================================
# AI-Powered Interview Coach - Git Ignore
# =====================================================================

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDEs & OS Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Project Runtime Database
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Candidate Uploads (Personal Information Privacy)
data/uploads/*
!data/uploads/.gitkeep

# Chroma Vector Database Persistence
data/vector_store/*
!data/vector_store/.gitkeep

# Local Speech / NLP Models Cache
data/models/*
!data/models/.gitkeep
models/
.cache/

# Audio Files (Privacy & Size)
*.wav
*.mp3
*.m4a
*.ogg
*.webm
*.flac
*.aac

# Logs & Temporary Files
*.log
*.tmp
*.temp
scratch/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Distribution & Packaging
dist/
build/
*.egg-info/
